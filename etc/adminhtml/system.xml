<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="byte8" translate="label" sortOrder="400">
            <label>Byte8</label>
        </tab>
        <section id="byte8_compliance" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Compliance</label>
            <tab>byte8</tab>
            <resource>Byte8_Compliance::config</resource>
            <group id="legal_guarantee" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Legal Guarantee (Gesetzliche Gewährleistung)</label>
                <comment><![CDATA[EU statutory-warranty notice (EmpCo, from 27 Sep 2026). Pick the official label language per store view below; these toggles control where it appears on the store views that have a language selected.]]></comment>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Legal Guarantee Notice</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Master switch. When No, the notice is hidden on every surface regardless of the toggles below.</comment>
                </field>
                <field id="label_language" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Official Label Language</label>
                    <source_model>Byte8\Compliance\Model\Config\Source\LabelLanguage</source_model>
                    <depends><field id="enabled">1</field></depends>
                    <comment><![CDATA[The official EU statutory-warranty label to display on THIS store view. Set it per store view (switch the scope selector, top-left) — e.g. German for a German (EU) store. Leave "Not applicable" for non-EU store views (e.g. Switzerland) so the notice stays hidden there. The notice renders only where a language is selected.]]></comment>
                </field>
                <field id="show_on_pdp" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show on Product Page</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="show_in_cart" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show in Cart</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="show_in_checkout" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show in Checkout</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
        </section>
    </system>
</config>
